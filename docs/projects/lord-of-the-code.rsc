10:["$","ul",null,{"children":[["$","li","Nine agent definitions across the Opus, Sonnet and Haiku tiers.",{"children":"Nine agent definitions across the Opus, Sonnet and Haiku tiers."}],["$","li","Four review formations plus the Scribe-Merge review, fix and pull-request workflow.",{"children":"Four review formations plus the Scribe-Merge review, fix and pull-request workflow."}],["$","li","An install script that adds the skill, the agents and the /lotc shorthand.",{"children":"An install script that adds the skill, the agents and the /lotc shorthand."}]]}]
