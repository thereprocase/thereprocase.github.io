f:["$","ul",null,{"children":[["$","li","Image-first Gridline workspace, locked/automatic span, palettes and sensor-driven full-screen rotation.",{"children":"Image-first Gridline workspace, locked/automatic span, palettes and sensor-driven full-screen rotation."}],["$","li","Sensor-coordinate spots, boxes, line profiles, point delta and inclusive isotherms.",{"children":"Sensor-coordinate spots, boxes, line profiles, point delta and inclusive isotherms."}],["$","li","Integrated 8–14 µm Planck graybody correction with explicit model assumptions.",{"children":"Integrated 8–14 µm Planck graybody correction with explicit model assumptions."}],["$","li","Annotated PNG, original lossless 16-bit plane and JSON sidecar; Android sharing.",{"children":"Annotated PNG, original lossless 16-bit plane and JSON sidecar; Android sharing."}],["$","li","Saved-capture gallery and reanalysis preserve original samples, acquisition time and available device context.",{"children":"Saved-capture gallery and reanalysis preserve original samples, acquisition time and available device context."}]]}]
