19:["$","section",null,{"className":"gl-pane","id":"record","aria-labelledby":"record-title","children":[["$","div",null,{"className":"gl-pane-title","children":[["$","h2",null,{"id":"record-title","children":"05 / AN OPEN PROJECT RECORD"}],["$","span",null,{"children":"DESIGN → ANALYSIS → PHYSICAL CHECKS"}]]}],["$","div",null,{"className":"sr-two-column","children":[["$","div",null,{"className":"sr-copy","children":[["$","h3",null,{"children":"The earlier shapes stay on record."}],["$","p",null,{"children":"E11 explored a deeper reinforcement. E12 reduced the protrusion. E13 adds straight tapers and a little depth, then follows the change through section checks, slicer paths and refined stress fields."}],["$","div",null,{"className":"sr-actions","children":[["$","a",null,{"className":"gl-button","href":"https://github.com/thereprocase/spool-wall-rack/blob/5e95cbf5544b205bdf2b73611d24ce3f826e837d/DESIGN-JOURNAL.md","children":"Read the design journal ↗"}],["$","a",null,{"className":"gl-button","href":"https://github.com/thereprocase/spool-wall-rack","children":"Open the repository ↗"}]]}]]}],["$","div",null,{"className":"sr-copy sr-qualification","children":[["$","h3",null,{"children":"Next: prove the printed rack."}],["$","p",null,{"children":"Check rod fit and snap retention, immediate loaded movement, dowel sag and wall contact. Measure drift under the intended warm service conditions and inspect for cracking or layer separation."}],["$","p",null,{"children":"No physical proof test or lifetime qualification is claimed. All figures and downloads on this page come from the published E13 revision."}]]}]]}]]}]
