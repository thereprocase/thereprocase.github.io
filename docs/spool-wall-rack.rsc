13:["$","div",null,{"className":"sr-two-column","children":[["$","div",null,{"className":"sr-copy","children":[["$","h3",null,{"children":"Strength follows the shape."}],["$","p",null,{"children":"Two long, straight flanks lead into a short flat underside. The 11 mm reinforcement is only 1.5 mm deeper than the curved E12, with a broader taper into the knee and outer arm."}],["$","p",null,{"children":"Small corner blends and mirrored chamfers finish the edges. The original flexible fingers, relief pockets, screw access and rod positions stay in place."}],["$","dl",null,{"className":"sr-facts","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Flanks"}],["$","dd",null,{"children":"41 mm horizontal run · about 15°"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Flat underside"}],["$","dd",null,{"children":"28 mm long"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Inner-center section"}],["$","dd",null,{"children":"30 mm deep"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Nominal rod seat"}],["$","dd",null,{"children":"26.0 mm for nominal 25.4 mm stock"}]]}]]}],["$","p",null,{"className":"sr-caption","children":"Measure the actual rods and print a fit coupon before making the rack."}],["$","a",null,{"href":"https://github.com/thereprocase/spool-wall-rack/blob/5e95cbf5544b205bdf2b73611d24ce3f826e837d/fit/README.md","children":"Rod fit coupons & measurement plan ↗"}]]}],["$","figure",null,{"className":"sr-figure","children":[["$","a",null,{"href":"/spool-wall-rack/assets/depth-comparison.png","aria-label":"Open full-size figure: Overlay of E13 straight underside tapers and the earlier curved E12 reinforcement","children":["$","img",null,{"src":"/spool-wall-rack/assets/depth-comparison.png","alt":"Overlay of E13 straight underside tapers and the earlier curved E12 reinforcement","width":1920,"height":1120,"loading":"lazy"}]}],["$","figcaption",null,{"children":["THE SHAPE CHANGE / E12 TO E13",["$","a",null,{"href":"/spool-wall-rack/assets/depth-comparison.png","children":"Full size ↗"}]]}]]}]]}]
