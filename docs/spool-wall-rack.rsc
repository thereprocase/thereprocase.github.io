33:["$","div",null,{"className":"sr-copy","children":[["$","p",null,{"children":["At the reference load, grade-specific room-temperature moduli give about ",["$","strong",null,{"children":"0.627 mm"}]," initial front movement for the 8-wall PLA case and ",["$","strong",null,{"children":"0.838 mm"}]," for 10-wall PETG. These are bracket-only model results. Rod sag, mounting movement, heat and creep still need to be accounted for."]}],["$","div",null,{"className":"sr-actions","children":[["$","a",null,{"className":"gl-button","href":"https://github.com/thereprocase/spool-wall-rack/blob/5e95cbf5544b205bdf2b73611d24ce3f826e837d/analysis/e13/RESULTS.md","children":"Materials, loads & creep sensitivities ↗"}],["$","a",null,{"className":"gl-button","href":"/spool-wall-rack/assets/hotspot-comparison.png","children":"Open hotspot comparison ↗"}]]}]]}]
